NODE_ENV=production
GEMINI_API_KEY=${GEMINI_API_KEY}

# Server Configuration
PORT=3000
HOST=0.0.0.0

# Security Headers
ENABLE_SECURITY_HEADERS=true
CORS_ORIGIN=*

# Logging Configuration
LOG_LEVEL=info
LOG_RETENTION_DAYS=30

# Performance
MAX_REQUEST_SIZE=10mb
REQUEST_TIMEOUT=30000

# Database/Cache (if needed in future)
# REDIS_URL=
# DATABASE_URL=
